# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Google Maps Platform API key with the Places API (New) enabled.
# https://developers.google.com/maps/documentation/places/web-service/get-api-key
GOOGLE_MAPS_API_KEY=your_api_key_here

# Optional overrides --------------------------------------------------------

# Default region for parsing phone numbers without a country code (ISO 3166).
# ENRICH_REGION=US

# Web-search fallback (optional) --------------------------------------------
# Finds an official website when Google Places has none, by searching the web
# and accepting only a standalone, name-matching domain. Configure ONE provider:
#
#   Serper.dev (Google results, simplest) -> https://serper.dev
# SERPER_API_KEY=your_serper_key
#
#   Brave Search (independent index)      -> https://brave.com/search/api
# BRAVE_API_KEY=your_brave_key
#
# Force a provider if more than one key is set (serper | brave | google_cse):
# WEB_SEARCH_PROVIDER=serper
#
# Note: new Google Programmable Search Engines can no longer search the whole
# web (Jan 2026), so GOOGLE_CSE_ID only works for legacy whole-web engines.
